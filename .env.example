# Copy this file to .env and fill in the values.
# .env is excluded from Git, so your real passwords are never committed.

# Airflow
AIRFLOW_UID=50000
FERNET_KEY=generate-one-see-README

# MySQL staging database
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=flights_staging
MYSQL_USER=flights_user
MYSQL_PASSWORD=change_me

# PostgreSQL analytics database
ANALYTICS_DB=flights_analytics
ANALYTICS_USER=analytics_user
ANALYTICS_PASSWORD=change_me
